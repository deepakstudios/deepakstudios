    depth = 0
    for i in range(s, len(lines)):
        depth += len(re.findall(r"<div\b", lines[i]))
        depth -= len(re.findall(r"</div>", lines[i]))
        if depth == 0 and i > s:
            return s, i
    raise RuntimeError("close seam missing (" + what + ")")

