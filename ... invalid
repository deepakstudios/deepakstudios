def git_bin(*args):
    return subprocess.run(["git", "-C", G, *args], capture_output=True, check=True).stdout.decode("utf-8", "replace")

def readlines(path):
    with io.open(path, "r", encoding="utf-8", newline="") as f:
        return f.read().split("\n")

def writelines(path, lines):
    with io.open(path, "w", encoding="utf-8", newline="") as f:
        f.write("\n".join(lines))

def find_seam(lines, open_re, close_re, what):
    for i, ln in enumerate(lines):
        if re.search(open_re, ln):
            s = i
            break
    else:
        raise RuntimeError("open seam missing: " + open_re + " (" + what + ")")
    depth = 0
    for i in range(s, len(lines)):
        depth += len(re.findall(r"<nav\b", lines[i]))
        depth -= len(re.findall(r"</nav>", lines[i]))
        if depth == 0 and i > s:
            return s, i
    raise RuntimeError("close seam missing: " + close_re + " (" + what + ")")

def find_div_seam(lines, open_re, what):
